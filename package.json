{
  "name": "blitz-score",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@ionic/core": "^8.8.2",
    "@ionic/react": "^8.8.2",
    "@ionic/react-router": "^8.8.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "ionicons": "^8.0.13",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4",
    "typescript": "^6.0.2"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build && cp build/index.html build/404.html && npm run build-privacy",
    "build-privacy": "markdown-to-html-cli --source privacy.md --output build/privacy.html",
    "preview": "vite preview",
    "assets": "npx @capacitor/assets generate --iconBackgroundColor '#1c833c' --iconBackgroundColorDark '#1c833c' --splashBackgroundColor '#1c833c' --splashBackgroundColorDark '#1c833c'"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "markdown-to-html-cli": "^4.1.0",
    "prettier": "^2.8.1",
    "vite": "^8.0.3"
  },
  "description": "An Ionic project"
}
